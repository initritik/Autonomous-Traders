# ---------------------------------------------------------------------------
# 6_mcp trading floor - environment variables
#
# All LLM calls in this project go through the OpenAI Python SDK
# (AsyncOpenAI / OpenAIChatCompletionsModel), just pointed at each
# provider's OpenAI-compatible base URL. No native OPENAI_API_KEY is used
# anywhere - see backend/traders.py for the client setup.
# ---------------------------------------------------------------------------

# --- LLM providers (all required if USE_MANY_MODELS=true; GOOGLE_API_KEY
#     alone is enough if USE_MANY_MODELS=false, since every trader then
#     runs on Gemini) ---

# Google Gemini API key. Get one free at https://aistudio.google.com/apikey
# Used via the OpenAI-compatible endpoint: generativelanguage.googleapis.com/v1beta/openai/
GOOGLE_API_KEY=xxxx

# DeepSeek API key. Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=xxxx

# Groq API key (free tier). Get one at https://console.groq.com/keys
GROQ_API_KEY=xxxx

# --- Trading floor behaviour ---

# If "true", the four traders use four different models (Gemini, DeepSeek,
# Groq, Gemini again). If "false" (default), all four traders run on
# Gemini 3.1 Flash Lite.
USE_MANY_MODELS=false

# How often (minutes) the scheduler runs the traders.
RUN_EVERY_N_MINUTES=60

# If "true", traders run even when the market is closed (useful for testing).
RUN_EVEN_WHEN_MARKET_IS_CLOSED=false

# --- Optional integrations (leave blank to use built-in fallbacks) ---

# Tavily web search key, used by the researcher's search tool.
TAVILY_API_KEY=xxxx

# Massive market-data API key. Without it, a local simulator is used instead.
MASSIVE_API_KEY=xxxx